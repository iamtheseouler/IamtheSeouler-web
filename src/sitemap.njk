---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- A list of every page on the site, for search engines. Without it they have
    to stumble across pages by following links; with it they are handed the
    whole map. The date on each entry tells them what has changed since they
    last looked. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/gallery</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {#- Each post twice: the English page and its Korean twin. Both are listed
      so neither waits to be stumbled upon. -#}
  {%- for post in collections.journal %}
  <url>
    <loc>{{ site.url }}{{ post.url | clean }}</loc>
    <lastmod>{{ post.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ site.url }}/ko{{ post.url | clean }}</loc>
    <lastmod>{{ post.date | isoDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
  {%- endfor %}
</urlset>
