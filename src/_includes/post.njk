---
layout: base.njk
---
{#- The English page. Its Korean twin lives at /ko/<slug> and is built by
    src/posts-ko.njk from the same file.

    These used to be one page holding both languages, with the toggle hiding
    one of them. A search engine reading that saw an English document with
    Korean inside it, which is why nothing on this site could be found by
    searching in Korean — and nine in ten visitors are in Korea. Two pages,
    each in one language, each with its own address, fixes that. -#}
<div class="wrap">
  {% include "nav.njk" %}
  <div class="lang-toggle">
    <span class="active">EN</span>
    <a href="/ko{{ page.url | clean }}" hreflang="ko" lang="ko">한글</a>
  </div>
</div>

<header class="story-head">
  <div class="wrap">
    <div class="story-meta">{{ meta_en }}</div>
    <h1>{{ title_en }}</h1>
    <p class="story-sub">{{ site.storySub }}</p>
    <p class="story-sub-kr">{{ sub_kr }}</p>
  </div>
</header>

<main class="story-body">
  <div class="wrap">
    <div class="story-inner" data-lb-group>

      <p class="lede">{{ lede_en }}</p>

{{ body_en | storyBody("en") | safe }}

    </div>
  </div>
</main>

{% set lang = "en" %}{% include "extras.njk" %}

<div class="story-close">
  <div class="wrap">
    <p class="line1">{{ site.closeLine1 }}</p>
    <p class="line2">{{ site.closeLine2 }}</p>
    <a class="back" href="/#journal">← Back to the Journal</a>
  </div>
</div>

{% include "lightbox.njk" %}
