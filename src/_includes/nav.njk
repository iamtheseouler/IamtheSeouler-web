{# The home page nav sits on the celadon field and needs light text;
   everywhere else it sits on paper. Pass onCeladon from the home page.
   The colours used to be inline styles; they are classes now so the
   phone's drawer can set its own without fighting them. #}
<nav{% if onCeladon %} class="on-celadon"{% endif %}>
  {%- if onCeladon %}
  <div class="mark">I am the <b>Seouler</b></div>
  {%- else %}
  <a href="/" class="mark">I am the <b>Seouler</b></a>
  {%- endif %}

  <button type="button" class="nav-toggle" aria-label="메뉴 열기" aria-expanded="false" aria-controls="nav-links">
    <span></span><span></span><span></span>
  </button>

  <div class="nav-scrim"></div>

  <div class="links" id="nav-links">
    <div class="links-head">
      <span class="links-title">I am the <b>Seouler</b></span>
      <button type="button" class="nav-close" aria-label="메뉴 닫기">&times;</button>
    </div>
    {%- if onCeladon %}
    <a href="#about">About</a>
    <a href="#journal">Journal</a>
    <a href="/gallery">Gallery</a>
    <a href="#subscribe">Subscribe</a>
    {%- else %}
    <a href="/#about">About</a>
    <a href="/#journal">Journal</a>
    <a href="/gallery">Gallery</a>
    <a href="/#subscribe">Subscribe</a>
    {%- endif %}
  </div>
</nav>

<script>
  (function(){
    var nav = document.querySelector('nav');
    if (!nav) return;
    var btn = nav.querySelector('.nav-toggle');
    var links = nav.querySelector('.links');
    if (!btn || !links) return;
    function set(open){
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    }
    btn.addEventListener('click', function(){ set(!nav.classList.contains('open')); });
    // Tapping a link should take you there, not leave the drawer covering it.
    links.addEventListener('click', function(e){ if (e.target.closest('a')) set(false); });
    nav.querySelector('.nav-close').addEventListener('click', function(){ set(false); });
    nav.querySelector('.nav-scrim').addEventListener('click', function(){ set(false); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') set(false); });
    window.addEventListener('resize', function(){ if (window.innerWidth > 780) set(false); });
  })();
</script>
