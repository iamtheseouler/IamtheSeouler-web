<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if seoTitle %}{% set pageTitle = seoTitle %}
{% elif title_en %}{% set pageTitle = title_en + " | " + site.name %}
{% else %}{% set pageTitle = site.name %}{% endif %}
<title>{{ pageTitle }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
{#- One address per page. The site answers on both iamtheseouler.com and
    www.iamtheseouler.com, and Vercel sends the first to the second; this tells
    search engines which one is the real one so the two are never counted as
    two different pages holding the same writing. -#}
<link rel="canonical" href="{{ site.url }}{{ page.url | clean }}">
<meta name="author" content="{{ site.name }}">
{#- Proves to Google that we own the site, so Search Console will show us what
    people search for before they arrive. Not a secret; it only identifies. -#}
<meta name="google-site-verification" content="4w0a0uWypvIBywizh7xNqkPw9s4x8LoKCPzn0nIXfck">
<meta name="naver-site-verification" content="b0be221076128faca7919054154a6d100d7d5283">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">

{#- What a link to this page looks like when someone pastes it into KakaoTalk,
    Instagram, Slack or a message. Without these there is no picture and no
    title — only the bare address, which nobody clicks.

    ogImage is set per page (see each template); the 1200×630 files in /og are
    cropped for this and nothing else, because a tall photograph gets sliced
    badly by every one of these services. -#}
{#- A post's card is named after the post, so a new one is found without being
    named anywhere: write the post, and the build makes /og/og-<slug>.jpg. -#}
{% if ogImage %}{% set ogPic = ogImage %}
{% elif title_en %}{% set ogPic = "/og/og-" + page.fileSlug + ".jpg" %}
{% else %}{% set ogPic = "/og/og-home.jpg" %}{% endif %}
{% set ogDesc = description or site.storySub %}
{#- The title in the browser tab and in search results has work to do — it is
    the line someone reads before deciding to click, so it carries the words
    they might have searched for. A share card does not need that: the picture
    already says whose it is. So the two are allowed to differ. -#}
{% set shareTitle = ogTitle or title_en or site.name %}
<meta property="og:type" content="{% if title_en %}article{% else %}website{% endif %}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ shareTitle }}">
<meta property="og:description" content="{{ ogDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | clean }}">
<meta property="og:image" content="{{ site.url }}{{ ogPic }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_US">
<meta property="og:locale:alternate" content="ko_KR">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ shareTitle }}">
<meta name="twitter:description" content="{{ ogDesc }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogPic }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{# Korean is requested on its own line. Google serves Noto Serif KR as ~100
   subset files, and bundling it with the Latin families has been observed to
   leave the Korean subsets unfetched while the Latin ones load fine. Two
   requests to the same host cost nothing and the Korean text stays reliable. #}
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500;1,9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500{% if bodyClass == 'home' %}&family=Nothing+You+Could+Do{% endif %}&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
{# Analytics runs on the live site only, and never for the people who build it.
   Everything that used to be counted — preview deployments while checking a
   change, and our own visits to read what we just published — made the numbers
   describe us instead of the readers.

   Two gates:
     1. host must be the real domain (so *.vercel.app previews record nothing)
     2. the browser must not carry the opt-out mark

   To stop being counted on a device, visit /?notrack=1 once. /?notrack=0 undoes
   it. The mark lives in that browser, so it survives a changing IP — home wifi,
   the office, mobile data. #}
<script>
  window.seoulerCount = (function () {
    var host = location.hostname;
    var live = host === "iamtheseouler.com" || host === "www.iamtheseouler.com";
    try {
      var ask = new URLSearchParams(location.search).get("notrack");
      if (ask === "1") localStorage.setItem("seouler-notrack", "1");
      if (ask === "0") localStorage.removeItem("seouler-notrack");
      if (localStorage.getItem("seouler-notrack")) return false;
    } catch (e) { /* private mode: fall through and count */ }
    return live;
  })();

  if (window.seoulerCount) {
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
      t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", "{{ site.analytics.clarityId }}");
  }
</script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

{{ content | safe }}

<footer>
  <div class="wrap">
    <div class="mark">{{ site.name }}</div>
    <div class="info">© {{ site.year }} · {{ site.email }}</div>
  </div>
</footer>

<!-- Cloudflare Web Analytics — same two gates as Clarity above -->
<script>
  if (window.seoulerCount) {
    var cf = document.createElement("script");
    cf.type = "module";
    cf.defer = true;
    cf.src = "https://static.cloudflareinsights.com/beacon.min.js";
    cf.setAttribute("data-cf-beacon", '{"token": "{{ site.analytics.cloudflareToken }}"}');
    document.body.appendChild(cf);
  }
</script>
<!-- End Cloudflare Web Analytics -->
</body>
</html>
